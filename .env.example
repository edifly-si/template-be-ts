# Copy this file to .env and adjust the values for local development.

# MongoDB connection string
DATABASE_CONNECTION=mongodb://127.0.0.1:27017/template_be

# Application identity
NAME=template-be
SALT=change-this-salt
POD_NAME=local
VERSION=0.0.0
BUILD_TIME=2024-01-01T00:00:00.000Z

# Enables the permissive CORS middleware (development only)
DEV=true

# Header used to read the auth token. The frontend sends "srawungtoken".
AUTHHEADER=srawungtoken

# Optional: base64 (or raw PEM) RSA keys. When empty, key/private.pem and
# key/public.pem are used. Run `bash generateKey.sh` to create the key files.
# PRIVATE_KEY=
# PUBLIC_KEY=
